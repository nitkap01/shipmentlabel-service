# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ePost Global API keys. Sandbox confirmed 2026-08-27 (see tasks/2026-08-11/
# shipment-label-portal.md). Production stays unselectable in the UI until a
# production key is set here (D23).
EPG_API_KEY_SANDBOX=
EPG_API_KEY_PRODUCTION=

# Postgres (used by docker-compose.yml)
POSTGRES_DB=shipmentlabel
POSTGRES_USER=shipmentlabel
POSTGRES_PASSWORD=

# Backend. Required, no defaults (the backend will not start without them):
#   ADMIN_PASSWORD  at least 16 characters: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
#   SESSION_SECRET  at least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   (changing SESSION_SECRET logs everyone out)
ADMIN_PASSWORD=
SESSION_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=false
LABEL_PDF_DPI_FALLBACK=203
APP_TIMEZONE=America/New_York
BULK_MAX_ROWS=500
